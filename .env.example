# ROCA Environment Configuration
PROJECT_NAME="ROCA - Reproducible On-Chain Analytics Framework"
API_V1_STR=/api
ENVIRONMENT=development

# Database: SQLite by default for zero-config run, or PostgreSQL
DATABASE_URL=sqlite:///./roca.db
# DATABASE_URL=postgresql://roca_user:roca_secure_password@localhost:5432/roca_analytics

# Blockchain Integration (Optional Ganache RPC)
GANACHE_RPC_URL=http://127.0.0.1:7545
